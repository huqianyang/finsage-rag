{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "finsage-import",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--no-sync", "uvicorn", "app.import_app:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000,
      "env": {"PYTHONIOENCODING": "utf-8"}
    },
    {
      "name": "finsage-query",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--no-sync", "uvicorn", "app.query_app:app", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001,
      "env": {"PYTHONIOENCODING": "utf-8"}
    }
  ]
}
