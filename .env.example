# ===== 复制为 .env 后填写，.env 不提交 git =====

# ---- 大模型：硅基流动（问答 / 改写 / 元数据抽取 / 图片摘要） ----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
VLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LLM_TIMEOUT_SECONDS=60
# 是否开启模型思考模式（开启会明显增加首字延迟）
LLM_ENABLE_THINKING=false

# ---- 本地模型 ----
EMBEDDING_MODEL_PATH=D:/ai_models/modelscope_cache/models/BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL_PATH=D:/ai_models/rerank/rerank/BAAI/bge-reranker-large
RERANKER_MAX_LENGTH=512
# cuda / cpu
MODEL_DEVICE=cuda

# ---- 文档解析：MinerU 云 API ----
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_TIMEOUT_SECONDS=900

# ---- 联网搜索：阿里云百炼 WebSearch MCP（Key 为空则跳过联网搜索） ----
DASHSCOPE_API_KEY=
WEB_SEARCH_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
WEB_SEARCH_TOP_K=5

# ---- Milvus（虚拟机） ----
MILVUS_URI=http://192.168.10.100:19530
MILVUS_CHUNK_COLLECTION=fin_chunks
MILVUS_DOC_COLLECTION=fin_docs

# ---- MongoDB（虚拟机，已开鉴权） ----
MONGO_HOST=192.168.10.100
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_DB=finsage

# ---- MinIO（虚拟机） ----
MINIO_ENDPOINT=192.168.10.100:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_BUCKET=finsage
MINIO_SECURE=false

# ---- 导入 ----
UPLOAD_MAX_MB=50
IMPORT_WORKERS=2
CHUNK_TARGET_CHARS=500
CHUNK_MIN_CHARS=300
CHUNK_MAX_CHARS=800

# ---- 检索与问答 ----
HISTORY_TURNS=5
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RRF_TOP_N=20
RERANK_TOP_N=6
WEB_MAX_IN_CONTEXT=2
NO_ANSWER_SCORE_THRESHOLD=0.3
ENTITY_HIGH_CONFIDENCE=0.75
ENTITY_MID_CONFIDENCE=0.45
ENTITY_SCORE_GAP=0.08
ENTITY_MAX_OPTIONS=3

# ---- 服务 ----
LOG_LEVEL=INFO
